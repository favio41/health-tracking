{
	"permissions": {
		"allow": ["Bash(npm run *)", "Bash(grep *)", "Bash(find *)"],
		"deny": ["Read(./notes)", "Read(./data)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Write",
				"hooks": [
					{
						"type": "command",
						"command": "npm run format",
						"statusMessage": "Formatting code..."
					},
					{
						"type": "command",
						"command": "npm run check",
						"statusMessage": "Checking code..."
					},
					{
						"type": "command",
						"command": "npx tsc --noEmit",
						"statusMessage": "Validating TypeScript..."
					}
				]
			},
			{
				"matcher": "Edit",
				"hooks": [
					{
						"type": "command",
						"command": "npm run format",
						"statusMessage": "Formatting code..."
					},
					{
						"type": "command",
						"command": "npm run check",
						"statusMessage": "Checking code..."
					},
					{
						"type": "command",
						"command": "npx tsc --noEmit",
						"statusMessage": "Validating TypeScript..."
					}
				]
			}
		]
	}
}
